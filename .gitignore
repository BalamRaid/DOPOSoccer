# ============================================================
# DOPOSoccer - archivos que NO deben versionarse
# Regla: solo se sube código fuente, documentación, modelos y
# la configuración de VS Code (IDE de sustentación).
# ============================================================

# --- IDEs ---
# IntelliJ NO se usa en la entrega: se ignora por completo.
.idea/
*.iml
*.ipr
*.iws

# VS Code SÍ se usa: .vscode/ se VERSIONA a propósito.
# Contiene settings.json con "referencedLibraries": lib/*.jar.
# Si se ignora, un clon vuelve a tener "org.junit cannot be resolved".
# No añadir .vscode/ a este archivo.

# --- Salidas de compilación (se regeneran) ---
out/
bin/
build/
target/
*.class

# --- Archivos generados en tiempo de ejecución ---
sources.tmp
doposoccer-errors.log
*.log
*.tmp

# --- Informes internos (no se entregan) ---
AUDITORIA_DOPOSOCCER.txt

# --- Backups y comprimidos ---
*.zip
*.bak
*.backup
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
