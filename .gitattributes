# Fin de línea consistente según el tipo de archivo
*.java   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.puml   text eol=lf
*.bat    text eol=crlf
*.txt    text eol=lf

# Binarios: Git no debe intentar difundirlos ni cambiarles el fin de línea
*.jar    binary
*.asta   binary
*.png    binary
*.jpg    binary
